# Threads app credentials (Meta App Dashboard > Use cases > Threads API > Settings)
THREADS_APP_ID=
THREADS_APP_SECRET=
# Must exactly match a "Redirect Callback URL" registered in the dashboard (HTTPS)
THREADS_REDIRECT_URI=https://localhost/callback

# Option A: provide a (long-lived) token directly. Option B: run `threads-insights-auth login`
# which stores the token in THREADS_TOKEN_FILE.
THREADS_ACCESS_TOKEN=
# Optional; defaults to "me"
THREADS_USER_ID=

# Storage (defaults shown). Keep outside Git.
THREADS_DB_PATH=./data/threads_insights.db
THREADS_TOKEN_FILE=./data/token.json

# HTTP behaviour
THREADS_HTTP_TIMEOUT=15
